# make setup копирует этот файл в .env и подставляет случайный пароль.
POSTGRES_PASSWORD=change-me
# Внешний PostgreSQL (например, Neon). Если пусто — поднимается контейнер db из compose.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Формат: новый:base64,старый:base64; 32 байта. Пусто: вход отключён.
TOKEN_ENCRYPTION_KEYS=
PUBLIC_BASE_URL=http://localhost:8000
# Только для сервера: домен для сертификата Caddy. PUBLIC_BASE_URL тогда https://этот-домен.
DOMAIN=
# Приложение Яндекс ID (создаётся по README, часть 2, шаг 1). Пусто: вход и подключение кабинета отвечают
# «пока не настроено».
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Второе приложение, если доступ к API Директа одобрен у него, а не у приложения входа.
YANDEX_DIRECT_CLIENT_ID=
YANDEX_DIRECT_CLIENT_SECRET=
YANDEX_MANUAL_CLIENT_ID=
# Директ API. Выключен до согласования запуска с владельцем.
# Песочница: https://api-sandbox.direct.yandex.com и https://api-sandbox.direct.yandex.ru/live/v4/json/
DIRECT_ENABLED=false
DIRECT_API_URL=https://api.direct.yandex.com
DIRECT_LIVE_URL=https://api.direct.yandex.ru/live/v4/json/
# Тексты: любой OpenAI-совместимый API. Без ключа или модели объявления собираются из шаблонов.
# Ниже пара писатель + судья, прошедшая ворота выпуска на OpenRouter.
# Другую модель ставь только после своих ворот (evals.gate). Yandex AI Studio:
# https://ai.api.cloud.yandex.net/v1, PROJECT — каталог, модель gpt://<каталог>/yandexgpt/latest.
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL_PROJECT=
TEXT_MODEL_NAME=google/gemma-4-31b-it
# Судья проверяет смысл объявления по профилю и может только снять его. Пусто — выключен.
JUDGE_MODEL_NAME=deepseek/deepseek-v4.1-flash
# Рецензент автопилота: проверяет самостоятельные действия до выполнения, только останавливает.
REVIEW_MODEL_NAME=google/gemma-4-31b-it
# Картинки объявлений генератором OpenRouter тем же ключом, около $0,03 за картинку,
# не больше 3 в сутки на бизнес (images-1). false — только свои фото владельца.
IMAGE_GENERATION=true
# Письма о тревогах: любой SMTP. Яндекс 360: smtp.yandex.ru, порт 465, логин — ящик,
# пароль — пароль приложения. Пусто: письма ждут в очереди, adhelper check предупредит.
SMTP_HOST=
SMTP_PORT=465
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Бот Telegram от @BotFather: токен и имя без @. Пусто: Telegram в кабинете не подключить.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# Режим автопилота «Сам»: разрешает только владелец проекта после ворот этапа 9. По умолчанию нет.
AUTOPILOT_AUTO_ALLOWED=false
# Адрес API Метрики (визиты и цели); менять не нужно.
METRIKA_API_URL=https://api-metrika.yandex.net
# Порты на этой машине; наружу не публикуются.
POSTGRES_PORT=5433
APP_PORT=8000
