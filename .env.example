# make setup копирует этот файл в .env и подставляет случайный пароль.
POSTGRES_PASSWORD=change-me
# Формат: новый:base64,старый:base64; 32 байта. Пусто: вход отключён.
TOKEN_ENCRYPTION_KEYS=
PUBLIC_BASE_URL=http://localhost:8000
# Только для сервера: домен для сертификата Caddy. PUBLIC_BASE_URL тогда https://этот-домен.
DOMAIN=
# Тексты: любой OpenAI-совместимый API. Без ключа или модели объявления собираются из шаблонов.
# Yandex AI Studio: адрес ниже, PROJECT — каталог, модель gpt://<каталог>/yandexgpt/latest.
# OpenRouter: https://openrouter.ai/api/v1, PROJECT пусто, модель например qwen/qwen3-30b-a3b-instruct-2507.
TEXT_MODEL_BASE_URL=https://ai.api.cloud.yandex.net/v1
TEXT_MODEL_API_KEY=
TEXT_MODEL_PROJECT=
TEXT_MODEL_NAME=
# Судья проверяет смысл объявления по профилю и может только снять его. Пусто — выключен.
JUDGE_MODEL_NAME=
# Порты на этой машине; наружу не публикуются.
POSTGRES_PORT=5433
APP_PORT=8000
