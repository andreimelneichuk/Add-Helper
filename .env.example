# make setup копирует этот файл в .env и подставляет случайный пароль.
POSTGRES_PASSWORD=change-me
# Формат: новый:base64,старый:base64; 32 байта. Пусто: вход отключён.
TOKEN_ENCRYPTION_KEYS=
PUBLIC_BASE_URL=http://localhost:8000
# Только для сервера: домен для сертификата Caddy. PUBLIC_BASE_URL тогда https://этот-домен.
DOMAIN=
# Провайдер текстов: yandex или none. Без ключа объявления собираются из шаблонов профиля.
TEXT_MODEL_PROVIDER=yandex
TEXT_MODEL_API_KEY=
TEXT_MODEL_FOLDER=
TEXT_MODEL_NAME=yandexgpt-5.1
# Порты на этой машине; наружу не публикуются.
POSTGRES_PORT=5433
APP_PORT=8000
