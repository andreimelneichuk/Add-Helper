# make setup копирует этот файл в .env и подставляет случайный пароль.
POSTGRES_PASSWORD=change-me
# Формат: новый:base64,старый:base64; 32 байта. Пусто: вход отключён.
TOKEN_ENCRYPTION_KEYS=
PUBLIC_BASE_URL=http://localhost:8000
# Порты на этой машине; наружу не публикуются.
POSTGRES_PORT=5433
APP_PORT=8000
